# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Session Encryption Secret (min 32 characters)
SESSION_SECRET="development_secret_must_be_at_least_32_bytes_long_hunch"

# PostgreSQL Connection String (with pgvector extension)
DATABASE_URL="postgresql://postgres:password@localhost:5432/hunch"

# Steam Web API Key (Get one at https://steamcommunity.com/dev/apikey)
STEAM_API_KEY="your_steam_web_api_key_here"

# Inngest Background Jobs
INNGEST_EVENT_KEY="local"
INNGEST_SIGNING_KEY="local"

# Supabase Realtime (for Squad multiplayer rooms)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"

