# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing & coverage
/coverage
*.lcov

# next.js build & output
/.next/
/out/
/build

# environment files (prevent accidental token/key leaks)
.env*
!.env.example

# secrets, keys, and certificates
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
id_rsa*
id_ed25519*

# logs and debug files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# OS metadata
.DS_Store
Thumbs.db
Desktop.ini

# IDE & Editor settings
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# Docker local overrides
docker-compose.override.yml

# vercel
.vercel

# typescript & lint cache
*.tsbuildinfo
next-env.d.ts
.eslintcache
